{
    "name": "picklers/webdev-project",
    "description": "PICKLERS — #1 Philippines Pickleball Booking Platform",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Picklers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Picklers\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php vendor/bin/phpunit"
        ],
        "verify": "@php scripts/verify.php"
    }
}
