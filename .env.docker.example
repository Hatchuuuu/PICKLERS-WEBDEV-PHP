# Copy to .env.docker and replace both passwords with different random values.
# This file configures Docker only; the existing XAMPP .env is never mounted.
DOCKER_DB_PASSWORD=replace-with-a-random-app-password
DOCKER_DB_ROOT_PASSWORD=replace-with-a-different-random-root-password
DOCKER_HTTP_PORT=8080
# Optional: set a stable random APP_SECRET across deployments/replicas.
# When blank, the application generates one in the persistent runtime volume.
DOCKER_APP_SECRET=
