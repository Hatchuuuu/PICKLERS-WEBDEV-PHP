{% extends 'admin/base.html.twig' %}

{% block title %}Viewing as {{ target_name }}{% endblock %}

{% block body %}
<main class="pk-error-page">
    <img src="{{ asset('assets/images/PICKLERS_OFFICIAL_LOGO.svg') }}" alt="PICKLERS" width="56" height="56">
    <h1>You are viewing the app as {{ target_name }}</h1>
    <p>The admin console is closed while you are signed in as someone else{{ expires_at ? ', until ' ~ expires_at|date('g:i A') ~ ' at the latest' }}.</p>
    <div class="pk-error-page__actions">
        <form method="post" action="{{ path('admin_impersonation_stop') }}">
            <input type="hidden" name="_token" value="{{ csrf_token_value() }}">
            <button type="submit" class="pk-btn pk-btn--primary">Return to admin</button>
        </form>
        <a class="pk-btn pk-btn--ghost" href="{{ app_url }}">Keep viewing as {{ target_name }}</a>
    </div>
</main>
{% endblock %}
