{# Error page for player/owner pages (the admin console renders its own). Never shows internals. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ status_code == 404 ? '404 Not Found' : 'System Notice' }} — PICKLERS</title>
  <style>
    body { background:#0A121F; color:#fff; font-family:sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; padding:20px; text-align:center; }
    h1 { font-size:28px; margin-bottom:12px; color:#55C39E; }
    p { color:#94A3B8; max-width:500px; line-height:1.6; margin:0 auto; }
    a { display:inline-block; margin-top:20px; padding:10px 24px; background:#55C39E; color:#0A121F; font-weight:700; border-radius:99px; text-decoration:none; }
  </style>
</head>
<body>
  <div>
    {% if status_code == 404 %}
      <h1>404 — Page Not Found</h1>
      <p>The requested page does not exist.</p>
      <a href="{{ url_to('app.php') }}">Return to Picklers App</a>
    {% else %}
      <h1>Something went wrong</h1>
      <p>We encountered an unexpected condition. The engineering team has been notified.</p>
      <a href="javascript:history.back()">Go Back</a>
    {% endif %}
  </div>
</body>
</html>
