# ==============================================================================
# PICKLERS — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# ==============================================================================

APP_NAME="PICKLERS - Philippines Pickleball Platform"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_URL=http://localhost/PICKLERS%20WEBDEV%20PROJECT

DB_DRIVER=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=picklers_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Data integrity
# ------------------------------------------------------------------------------
# When true, the app REFUSES to fall back to JSON file storage if MySQL is
# unreachable. Leave false for local dev (so the app still boots without
# MySQL running), but set this to true in production — a silent failover
# there means accepting real bookings and payments into files the actual
# database will never see, with no visible sign to players or the owner
# beyond an error_log line.
DB_STRICT_MYSQL=false

# ------------------------------------------------------------------------------
# Payments
# ------------------------------------------------------------------------------
# No payment gateway is integrated yet. Wallet top-ups therefore FAIL CLOSED in
# production so that credits (real spending power) can never be minted from an
# unverified client request. Set this to true in local/dev ONLY to keep the
# simulated top-up flow usable for demos and testing.
# Ignored entirely when APP_ENV=production.
PAYMENTS_SIMULATED=true

# Sign-up bonus in Pickle Credits granted to each new account (0 disables it).
# This is real spending power and is farmable with throwaway registrations,
# so keep it at 0 unless you are deliberately running a launch promo.
# Hard-capped at 500.
SIGNUP_BONUS_CREDITS=0
